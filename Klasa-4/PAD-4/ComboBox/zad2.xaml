<Window x:Class="zad2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:zad2"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                <TextBlock Text="Bok a:" Margin="5"></TextBlock>
                <TextBox x:Name="A" Width="100" Margin="5"></TextBox>
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                <TextBlock Text="Bok b:" Margin="5"></TextBlock>
                <TextBox x:Name="B" Width="100" Margin="5"></TextBox>
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                <TextBlock Text="Oblicz" Margin="5"></TextBlock>
                <ComboBox x:Name="comboBox" Margin="5" Width="100" SelectionChanged="comboBox_SelectionChanged">
                    <ComboBoxItem Content="--Wybierz--" IsSelected="True"></ComboBoxItem>
                    <ComboBoxItem Content="Pole" ></ComboBoxItem>
                    <ComboBoxItem Content="Obwod"></ComboBoxItem>
                </ComboBox>
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                <TextBlock x:Name="result" FontWeight="Bold"></TextBlock>
            </StackPanel>
        </StackPanel>   
    </Grid>
</Window>
