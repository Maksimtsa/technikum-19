<Window x:Class="powtZad1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:powtZad1"
        mc:Ignorable="d"
        Title="Firma remontowa" Height="450" Width="800">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">

            <TextBlock Text="Wybierz usługi" FontSize="18" Margin="0,0,0,10"/>

            <CheckBox x:Name="Malowanie" Content="Malowanie" Margin="0,5" Checked="toggleChanged" Unchecked="toggleChanged"/>
            <CheckBox x:Name="PrzygotowaniePodloza" Content="Przygotowanie podłoża" Margin="0,5" Checked="toggleChanged" Unchecked="toggleChanged"/>
            <CheckBox x:Name="InstalacjeElektryczne" Content="Wykonanie instalacji elektrycznej" Margin="0,5" Checked="toggleChanged" Unchecked="toggleChanged"/>
            <CheckBox x:Name="MontazGniazdek" Content="Montaż gniazdek" Margin="0,5" Checked="toggleChanged" Unchecked="toggleChanged"/>
            <CheckBox x:Name="PodlaczenieUrzadzen" Content="Podłączenie urządzeń" Margin="0,5" Checked="toggleChanged" Unchecked="toggleChanged"/>

        </StackPanel>

        <TextBlock x:Name="ResultBlock" Grid.Row="1" FontSize="14" Margin="0,20,0,0" TextWrapping="Wrap"/>

    </Grid>
</Window>
