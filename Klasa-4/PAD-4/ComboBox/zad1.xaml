<Window x:Class="zad1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:zad1"
        mc:Ignorable="d"
        Title="Kalkulator" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="35"></RowDefinition>
            <RowDefinition Height="35"></RowDefinition>
            <RowDefinition Height="35"></RowDefinition>
            <RowDefinition Height="35"></RowDefinition>
            <RowDefinition Height="35"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="60"></ColumnDefinition>
            <ColumnDefinition Width="200"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Row="0" Text="Liczba 1:" VerticalAlignment="Center" HorizontalAlignment="Center"></TextBlock>
        <TextBlock Grid.Row="1" Text="Liczba 2:" VerticalAlignment="Center" HorizontalAlignment="Center"></TextBlock>
        <TextBlock Grid.Row="2" Text="Dzialanie:" VerticalAlignment="Center" HorizontalAlignment="Center"></TextBlock>
        <Button x:Name="btn" Grid.Row="3" Content="Oblicz" Grid.ColumnSpan="2" Width="100px" HorizontalAlignment="Left" Margin="5" Click="btn_Click"></Button>
        <TextBlock Grid.Row="4" Text="Wynik:" VerticalAlignment="Center" HorizontalAlignment="Center"></TextBlock>

        <TextBox Grid.Row="0" Grid.Column="1" x:Name="number1" HorizontalAlignment="Left" VerticalAlignment="Center" Width="100px"></TextBox>
        <TextBox Grid.Row="1" Grid.Column="1" x:Name="number2" HorizontalAlignment="Left" VerticalAlignment="Center" Width="100px"></TextBox>
        <ComboBox x:Name="comboBox" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Width="50px">
            <ComboBoxItem Content="-" IsSelected="True"/>
            <ComboBoxItem Content="+"/>
            <ComboBoxItem Content="*"/>
            <ComboBoxItem Content="/"/>
        </ComboBox>
        <TextBox Grid.Row="4" Grid.Column="1" x:Name="resultBox" HorizontalAlignment="Left" VerticalAlignment="Center" Width="100px"></TextBox>
    </Grid>
</Window>
