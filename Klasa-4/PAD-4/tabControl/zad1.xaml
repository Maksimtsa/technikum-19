<Window x:Class="WpfApp2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp2"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <TabControl  x:Name="TabControlKarty" SelectionChanged="TabControlKarty_SelectionChanged">
            <TabItem Header="Dane podstawowe" x:Name="TabItemDane">
                <StackPanel Margin="15">
                    <Label Content="Imię:" />
                    <TextBox x:Name="TxtImie" Padding="3"/>

                    <Label Content="Nazwisko:" />
                    <TextBox x:Name="TxtNazwisko" Padding="3"/>

                    <Label Content="Data urodzenia:" />
                    <DatePicker x:Name="DpDataUrodzenia" Padding="3"/>

                    <Label Content="Płeć:" />
                    <ComboBox x:Name="CbPlec" Padding="3">
                        <ComboBoxItem Content="Kobieta"/>
                        <ComboBoxItem Content="Mężczyzna"/>
                    </ComboBox>
                </StackPanel>
            </TabItem>
            <TabItem Header="Adres zamieszkania" x:Name="TabItemAdres">
                <StackPanel Margin="15">
                    <Label Content="Ulica:" />
                    <TextBox x:Name="TxtUlica" Margin="0,0,0,10" Padding="3"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="450"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <Label Content="Numer domu/mieszkania:" />
                            <TextBox x:Name="TxtNrDomu" Padding="3"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="5,0,0,10">
                            <Label Content="Kod pocztowy:" />
                            <TextBox x:Name="TxtKodPocztowy" Padding="3"/>
                        </StackPanel>
                    </Grid>

                    <Label Content="Miejscowość:" />
                    <TextBox x:Name="TxtMiejscowosc" Padding="3"/>
                </StackPanel>
            </TabItem>
            <TabItem Header="Podsumowanie" x:Name="TabItemPodsumowanie">
                <Grid Margin="15">
                    <TextBlock x:Name="TxtBlockPodsumowanie" TextWrapping="Wrap" FontSize="14" LineHeight="22"/>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
